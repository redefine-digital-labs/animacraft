{
  "name": "animacraft",
  "version": "0.8.5",
  "private": true,
  "type": "module",
  "description": "The Fully Onchain Character Maker & Creator",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "scan:fresh": "node scripts/fresh-v8-delivery-scan.mjs --all",
    "scan:fresh:source": "node scripts/fresh-v8-delivery-scan.mjs --source",
    "scan:fresh:dist": "node scripts/fresh-v8-delivery-scan.mjs --dist",
    "smoke:sui-grpc:mainnet": "node scripts/maker-v8-sui-grpc-mainnet-smoke.mjs",
    "test": "node --test test/*.test.js test/*.test.mjs",
    "check:syntax": "for file in *.js scripts/*.mjs; do node --check \"$file\" || exit 1; done",
    "check": "npm run check:syntax && npm test && npm run build && npm run scan:fresh",
    "move:build": "node scripts/native-soul-test-graph.mjs --check build",
    "move:build:disassemble": "node scripts/native-soul-test-graph.mjs --check disassemble",
    "move:field-limits": "node scripts/native-soul-test-graph.mjs --check field-gates",
    "move:native-soul-boundary": "node scripts/verify-native-soul-boundary.mjs",
    "move:test": "node scripts/native-soul-test-graph.mjs --check packages",
    "move:probes": "node scripts/native-soul-test-graph.mjs --check probes",
    "move:size": "node scripts/native-soul-test-graph.mjs --check size-gates",
    "move:release-gates": "node scripts/native-soul-test-graph.mjs --check release-gates",
    "move:seal-cap:quick": "node test/harness/animacraft_v8_seal_cap_harness/scripts/verify_reproducibility.mjs",
    "move:seal-cap:harness": "npm run move:seal-cap:quick",
    "move:seal-cap:localnet": "node test/harness/animacraft_v8_seal_cap_harness/scripts/run_localnet_replay.mjs"
  },
  "dependencies": {
    "@mysten/dapp-kit-core": "1.6.4",
    "@mysten/seal": "1.4.4",
    "@mysten/slush-wallet": "1.1.4",
    "@mysten/sui": "2.26.2",
    "@mysten/wallet-standard": "0.21.4",
    "@mysten/walrus": "1.2.19",
    "@mysten/walrus-wasm": "0.3.1",
    "@noble/hashes": "2.2.0",
    "@protobuf-ts/runtime-rpc": "2.11.1",
    "@protobuf-ts/grpcweb-transport": "2.11.1"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.5",
    "vite": "8.1.4"
  },
  "engines": {
    "node": "22.x"
  }
}
